{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "node -e \"let f=require('node:fs'),p=require('node:path');try{let d=process.cwd();while(!f.existsSync(p.join(d,'.hosted-skills-starter','telemetry.mjs'))&&p.dirname(d)!==d)d=p.dirname(d);let s=p.join(d,'.hosted-skills-starter','telemetry.mjs');import(require('node:url').pathToFileURL(s).href).then(m=>m.runHook('copilot-cli')).then(()=>process.exit(0)).catch(()=>process.exit(0));}catch{}\" >/dev/null 2>&1 || true",
        "powershell": "try { node -e \"let f=require('node:fs'),p=require('node:path');try{let d=process.cwd();while(!f.existsSync(p.join(d,'.hosted-skills-starter','telemetry.mjs'))&&p.dirname(d)!==d)d=p.dirname(d);let s=p.join(d,'.hosted-skills-starter','telemetry.mjs');import(require('node:url').pathToFileURL(s).href).then(m=>m.runHook('copilot-cli')).then(()=>process.exit(0)).catch(()=>process.exit(0));}catch{}\" 2>$null | Out-Null } catch { }; exit 0",
        "timeoutSec": 4,
        "cwd": "."
      }
    ]
  }
}
