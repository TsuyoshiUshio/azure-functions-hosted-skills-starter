{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "cwd": ".",
        "bash": "node -e \"let f=require('node:fs'),p=require('node:path');try{let d=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;let s=p.join(d,'hooks','runtime','telemetry.mjs');import(require('node:url').pathToFileURL(s).href).then(m=>m.runHook('copilot-cli')).then(()=>process.exit(0)).catch(()=>process.exit(0));}catch{}\" >/dev/null 2>&1 || true",
        "powershell": "try { node -e \"let f=require('node:fs'),p=require('node:path');try{let d=process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;let s=p.join(d,'hooks','runtime','telemetry.mjs');import(require('node:url').pathToFileURL(s).href).then(m=>m.runHook('copilot-cli')).then(()=>process.exit(0)).catch(()=>process.exit(0));}catch{}\" 2>$null | Out-Null } catch { }; exit 0",
        "timeoutSec": 4
      }
    ]
  }
}
