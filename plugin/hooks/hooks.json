{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let f=require('node:fs'),p=require('node:path');try{let d=process.env.CLAUDE_PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT;let s=p.join(d,'hooks','runtime','telemetry.mjs');import(require('node:url').pathToFileURL(s).href).then(m=>m.runHook('claude-code')).then(()=>process.exit(0)).catch(()=>process.exit(0));}catch{}\" >/dev/null 2>&1 || true",
            "timeout": 4,
            "async": true
          }
        ]
      }
    ]
  }
}
